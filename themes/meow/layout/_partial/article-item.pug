.article-item
  -
    var articleUrl = url_for(post.path)
    if (is_category()) {
      articleUrl += '?nav=category&term=' + encodeURIComponent(page.category)
    } else if (is_tag()) {
      articleUrl += '?nav=tag&term=' + encodeURIComponent(page.tag)
    }
  a.article-item-card(href= articleUrl)
    .article-item-title
      span= post.title

    .article-item-preview
      - let content = ""
      if post.excerpt
        - content= strip_html(post.excerpt)
      else if post.summary
        - content= strip_html(markdown(post.summary))
      else
        - content= strip_html(post.content)
      
      span= truncate(content, {length: 75})

    .article-item-date
      time(datetime= date(post.date, 'YYYY-MM-DDTHH:mm:ss'))= date(post.date, 'YYYY-MM-DD')
