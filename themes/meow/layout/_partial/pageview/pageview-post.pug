.pageview-post
  i.icon.fa-regular.fa-eye
  -
    const postPageviewSite = String(config.url).replace(/^https?:\/\//, '').split('/')[0]
    const postPageviewPath = url_for(post.path)
  span#post-pageview-container(
    data-api=theme.page_view.post_api
    data-site=postPageviewSite
    data-path=postPageviewPath)
    | #{ __('page_view.post_pv') }: 
    span#post-pageview-value
      i.fa-solid.fa-spinner
